<?xml version="1.0" encoding="utf-8"?>
<!-- ThreadReader launcher foreground: a post and a reply drawn as a comment thread,
     each line shown as a sound wave. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="1" android:translateY="5">
        <!-- Post author dot -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M29,34 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <!-- Thread line curving into the reply -->
        <path
            android:pathData="M34,41 V58 Q34,64 40,64"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />
        <!-- Post: sound-wave bars -->
        <path
            android:pathData="M46,32 V36 M53,27 V41 M60,30.5 V37.5 M67,26 V42 M74,32 V36"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <!-- Reply: sound-wave bars -->
        <path
            android:pathData="M48,61 V67 M55,57 V71 M62,60 V68 M69,62.5 V65.5"
            android:strokeColor="#FFB547"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
    </group>
</vector>
