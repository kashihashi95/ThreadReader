# -----------------------------------------------------------------------------
# App Secrets Configuration
# -----------------------------------------------------------------------------
# Copy this file to 'secrets.properties' in the project root to configure
# release signing.
#
# DO NOT commit 'secrets.properties' to git. It is listed in .gitignore.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Production Release Signing Keystore Configuration
# -----------------------------------------------------------------------------
# RELEASE_STORE_FILE=upload-keystore.jks
# RELEASE_STORE_PASSWORD=your_store_password
# RELEASE_KEY_ALIAS=upload
# RELEASE_KEY_PASSWORD=your_key_password
